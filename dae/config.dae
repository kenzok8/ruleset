# ============================================================
# dae 配置 · 完整版（AI 分组 + 国内外 DNS 分流）
# ============================================================
# 适用：dae / daed（含 luci-app-daede）
#
# 依赖 geo 数据：
#   /usr/share/v2ray/geosite.dat
#   /usr/share/v2ray/geoip.dat
#   OpenWrt 上装 v2ray-geosite + v2ray-geoip 即可，
#   luci-app-daede 的「更新 geo」会下载 Loyalsoldier 的版本。
#
# 三个必须确认的地方：
#   1. subscription 里的 sub：确认订阅 URL 返回 dae 支持的 URI 节点列表（含 SSR；不支持 Mihomo YAML）
#   2. global 里的 lan_interface：确认与设备实际使用的 LAN 网卡一致（x86 软路由一般是 br-lan，用 ip a 确认）
#   3. group 里的地区正则：改成订阅节点名中实际出现的地区关键字
# 分流思路参考 qichiyuhub/rule 的 dae 配置，按服务细分 AI 分组，
# 并补充 Telegram IP 分流与国内域名直连。
#
# 注意：dae 的组名只支持英文和数字，不能用中文和 emoji。
# ============================================================

# ---------------- 订阅 ----------------
# 订阅需返回 dae 支持的节点 URI（含 SSR）；不支持 mihomo YAML。
# 如果你的机场只给 mihomo 格式，用 sub-store 转一下，或者改用下面的 node 手写。
subscription {
    sub: 'https://example.com/sub'
}

# 手写节点示例（不想用订阅就打开这段）：
# node {
#     my_vps: 'hysteria2://密码@vps.example.com:443/?sni=vps.example.com'
#     # 链式代理：落地 -> 前置
#     relay: 'vless://UUID@us.example.com:443?security=tls&sni=us.example.com -> trojan://密码@hk.example.com:443?sni=hk.example.com'
# }

# ---------------- 策略组 ----------------
# policy 可选：
#   min_moving_avg  移动平均延迟最低（推荐，比 min 稳）
#   min_avg10       近 10 次平均延迟最低
#   min             最近一次延迟最低
#   random          随机
#   fixed(n)        固定组内第 n 个（从 0 开始数）
#
# `!name(regex: '排除')` 只排除节点名含“排除”的节点。
# 地区组无匹配节点时不会自动回退到 Final，需确认地区关键字与节点名相符。
group {
    # 总出口
    Proxy {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        policy: min_moving_avg
    }

    # --- AI：每家单独一组，按需要换地区 ---
    OpenAI {
        filter: name(regex: '🇸🇬|SG|sg|新加坡|狮城|Singapore') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Claude {
        filter: name(regex: '🇹🇼|TW|tw|台湾|台灣|Taiwan') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Gemini {
        filter: name(regex: '🇸🇬|SG|sg|新加坡|狮城|Singapore') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Muse {
        filter: name(regex: '🇸🇬|SG|sg|新加坡|狮城|Singapore') && !name(regex: '排除')
        policy: min_moving_avg
    }

    # --- 常用平台 ---
    YouTube {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Google {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Github {
        filter: name(regex: '🇯🇵|JP|jp|日本|日|Japan') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Telegram {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        policy: min_moving_avg
    }
    TikTok {
        filter: name(regex: '🇺🇸|US|us|美国|美|United States') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Netflix {
        filter: name(regex: '🇺🇸|US|us|美国|美|United States') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Wallet {
        filter: name(regex: '🇺🇸|US|us|美国|美|United States') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Steam {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Microsoft {
        filter: name(regex: '🇯🇵|JP|jp|日本|日|Japan') && !name(regex: '排除')
        policy: min_moving_avg
    }
    OneDrive {
        filter: name(regex: '🇯🇵|JP|jp|日本|日|Japan') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Apple {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        policy: min_moving_avg
    }

    # 漏网之鱼：不带任何地区过滤，全部节点参与
    Final {
        filter: !name(regex: '官网|剩余|流量|套餐|免费|订阅|到期时间|直连|Expire Date|Traffic|ExpireDate')
        policy: min_moving_avg
    }
}

# ---------------- DNS ----------------
dns {
    # local 指公共 Ali DNS，不是路由器 dnsmasq；LAN 私有域名可能无法解析。
    upstream {
        remote: 'https://8.8.8.8/dns-query'
        local: 'https://223.5.5.5/dns-query'
    }
    routing {
        request {
            # 禁用 HTTPS/SVCB 与 AAAA 记录查询。
            qtype(https, svcb) -> reject
            qtype(aaaa) -> reject

            # Google Play 相关域名使用国外 DNS。
            qname(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> remote

            # 国内域名走国内 DNS
            qname(geosite: cn, geosite: microsoft@cn, geosite: apple@cn, geosite: private) -> local
            # 国外域名走国外 DNS
            qname(geosite: geolocation-!cn) -> remote
            fallback: remote
        }
        response {
            # 国外 DNS 返回国内 IP（CDN 有国内节点）时，改用国内 DNS 重查，拿到就近节点
            upstream(remote) && ip(geoip: cn) -> local
            fallback: accept
        }
    }
}

# ---------------- 分流 ----------------
routing {
    # DNS 上游连接显式选出口，避免落入其他分流规则。
    dip(223.5.5.5) && l4proto(tcp) && dport(443) -> direct
    dip(8.8.8.8) && l4proto(tcp) && dport(443) -> Proxy

    # 组播地址不代理
    dip(224.0.0.0/3, 'ff00::/8') -> direct
    # 封掉 DoT，防止 App 绕过 dae 自己加密解析
    dport(853) -> block
    # 局域网地址直连
    dip(geoip: private) -> direct
    # 禁用 QUIC（443/UDP）；需要 HTTP/3 时可删除此规则。
    l4proto(udp) && dport(443) -> block

    # --- AI：每家一个组，不用笼统的 AI 组 ---
    # OpenAI（含 ChatGPT 静态资源域，geosite: openai 偶尔漏掉新版域名）
    domain(geosite: openai, suffix: openai.com, suffix: chatgpt.com,
           suffix: oaistatic.com, suffix: oaiusercontent.com) -> OpenAI
    # Claude / Anthropic：本仓库 rule/Claude.list 内联，geosite: anthropic 漏 datadog / sift 这类上报域名
    domain(suffix: anthropic.com, anthropic.team, claude.ai, claude.com, claude.app,
           claude.dev, claude.new, claude.site, clau.de, claudeacademy.com,
           claudemcpclient.com, claudemcpcontent.com, claudepages.dev,
           claudestudio.com, claudeusercontent.com, chatbotclaude.com, ant.dev,
           antspace.dev, datadoghq.com, datadoghq.eu, sift.com, siftscience.com) -> Claude
    domain(keyword: anthropic, claude) -> Claude
    domain(full: servd-anthropic-website.b-cdn.net, anthropic.com.cdn.cloudflare.net,
           anthropic.auth0.com, anthropic-com.ghost.io,
           browser-intake-us5-datadoghq.com, o1158394.ingest.us.sentry.io) -> Claude
    dip('160.79.104.0/23', '153.61.224.0/22', '2607:6bc0::/48') -> Claude
    # Gemini、NotebookLM 与部分 Google AI 页面。
    domain(geosite: google-gemini, suffix: gemini.google.com,
           suffix: notebooklm.google, suffix: withgoogle.com) -> Gemini
    domain(suffix: muse.ai) -> Muse
    # 其余 AI 站（Perplexity、Poe、Midjourney 等）不单独立组，归到 Proxy
    domain(geosite: category-ai-!cn) -> Proxy

    # --- 常用平台 ---
    domain(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> Google
    domain(geosite: youtube) -> YouTube
    domain(geosite: google) -> Google
    domain(geosite: github) -> Github
    domain(geosite: onedrive) -> OneDrive
    domain(geosite: microsoft@cn) -> direct
    domain(geosite: microsoft) -> Microsoft
    domain(geosite: apple@cn) -> direct
    domain(geosite: apple) -> Apple
    domain(geosite: telegram) -> Telegram
    dip(geoip: telegram) -> Telegram
    domain(geosite: tiktok) -> TikTok
    domain(geosite: netflix) -> Netflix
    domain(geosite: paypal, geosite: binance, geosite: okx, geosite: category-cryptocurrency) -> Wallet
    domain(geosite: steam@cn) -> direct
    domain(geosite: steam) -> Steam

    # --- 兜底 ---
    # 具体服务规则优先，其余国内域名和 IP 直连。
    domain(geosite: cn) -> direct
    dip(geoip: cn) -> direct
    domain(geosite: geolocation-!cn) -> Proxy
    fallback: Final
}

# ---------------- 全局 ----------------
global {
    # 局域网网卡。OpenWrt x86 一般是 br-lan；单网口设备可能是 eth0
    # 查法：ip a 看哪个接口的 inet 地址是你网关地址
    lan_interface: br-lan
    wan_interface: auto
    auto_config_kernel_parameter: true
    so_mark_from_dae: 0
    # 代理连接可使用嗅探域名；域名分流仍依赖 dae 接管 DNS。
    dial_mode: domain
    tls_implementation: utls
    bootstrap_resolver: '119.29.29.29:53'
    log_level: info
    check_interval: 30s
    check_tolerance: 50ms
}
